# The stack runs with the defaults baked into docker-compose.yml, so you do not
# need a .env file to get started. This file documents the variables you can
# override (copy to `.env` to use it).

# Backend
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0
MEDIA_DIR=/app/media

# Frontend (build-time, read by Vite)
VITE_API_URL=http://localhost:8000
